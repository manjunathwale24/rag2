# Copy to .env.local for local development. Never commit real values.

# Postgres with pgvector. Local: the rag2-pg Docker container. Production: a Neon connection string.
DATABASE_URL=postgres://postgres:dev@localhost:5433/rag2

# Signs login cookies. Use at least 32 random characters, for example from `openssl rand -base64 48`.
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Cloudflare Turnstile CAPTCHA on login and sign-up. For local dev, use the test keys below (they always pass).
# Never use the test keys in production. The public site key is safe to expose; keep the secret out of git.
# Test keys: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional overrides. Used by E2E tests to point at local stubs.
# TURNSTILE_VERIFY_URL=
# NEXT_PUBLIC_TURNSTILE_SCRIPT_URL=

# Vercel Blob. Create a private store in the Vercel dashboard and copy its token.
BLOB_READ_WRITE_TOKEN=

# NVIDIA. One key is used for both embeddings and chat. Create it at build.nvidia.com. Never commit it.
NVIDIA_API_KEY=

# Optional overrides. Used by E2E tests to point at local stubs.
# NVIDIA_EMBEDDING_URL=
# NVIDIA_CHAT_URL=
# NVIDIA_CHAT_MODEL=
